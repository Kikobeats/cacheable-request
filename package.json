{
  "name": "@kikobeats/cacheable-request",
  "description": "Wrap native HTTP requests with RFC compliant cache support",
  "homepage": "https://github.com/@kikobeats/cacheable-request#readme",
  "version": "7.0.8",
  "main": "src/index.js",
  "author": {
    "email": "josefrancisco.verdu@gmail.com",
    "name": "Kiko Beats",
    "url": "https://kikobeats.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/@kikobeats/cacheable-request.git"
  },
  "bugs": {
    "url": "https://github.com/@kikobeats/cacheable-request/issues"
  },
  "keywords": [
    "7234",
    "HTTP",
    "HTTPS",
    "RFC",
    "RFC 7234",
    "cache",
    "cacheable",
    "caching",
    "compliant",
    "layer"
  ],
  "dependencies": {
    "clone-response": "^2.0.0",
    "http-cache-semantics": "^4.1.1",
    "keyv": "^4.5.4",
    "normalize-url": "~9.0.1",
    "responselike": "^2.0.0"
  },
  "devDependencies": {
    "c8": "latest",
    "create-test-server": "latest",
    "esbuild": "latest",
    "get-stream": "5",
    "jest": "latest",
    "standard": "latest"
  },
  "engines": {
    "node": ">=20.19 <21 || >=22.12"
  },
  "files": [
    "src/index.js",
    "src/clone-response.js"
  ],
  "scripts": {
    "build": "echo \"export { default as cloneResponse } from 'clone-response'\" | esbuild --bundle --target=ES2019 --format=cjs --platform=node > src/clone-response.js",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "NODE_OPTIONS=--experimental-vm-modules c8 jest"
  },
  "license": "MIT"
